# ===========================================================
# PIL Cargo Claim & Survey Management System
# Production Environment Configuration Template
# ===========================================================
# INSTRUCTIONS:
#   1. Copy this file to .env (do NOT rename this file)
#   2. Fill in every value marked <REPLACE_THIS>
#   3. Never commit the real .env file to version control
#   4. Restrict file permissions: icacls .env /inheritance:r /grant:r "SYSTEM:(R)" "Administrators:(R)"
# ===========================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Public URL of the application (used for password reset links and email CTAs)
# For LAN-only: use the server's local IP, e.g. http://192.168.1.50:5000
# For HTTPS reverse proxy: use https://claims.pilship.com
APP_URL=<REPLACE_THIS: e.g. http://192.168.1.50:5000>

# ── PostgreSQL Database ──────────────────────────────────────
# Superuser credentials (used ONLY by backup scripts / migrations)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pil_claims_db
DB_USER=postgres
DB_PASSWORD=<REPLACE_THIS: your postgres superuser password>
DB_SSL=false

# Dedicated least-privilege application runtime user
# This user has SELECT/INSERT/UPDATE/DELETE only — NO DDL
DB_APP_USER=pil_app_user
# pil_app_user password must match what was set during initial DB setup

# ── Security ─────────────────────────────────────────────────
# JWT signing secret — MINIMUM 64 random characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<REPLACE_THIS: minimum 64 random hex characters>

# OTP hashing salt — MINIMUM 32 random characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SALT=<REPLACE_THIS: minimum 32 random hex characters>

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# LAN example: http://192.168.1.50:5000,http://192.168.1.50:5173
# HTTPS example: https://claims.pilship.com
ALLOWED_ORIGINS=<REPLACE_THIS: e.g. http://192.168.1.50:5000>

# ── Email Service ────────────────────────────────────────────
# Options: ms_graph | smtp | captured_test
# Use 'captured_test' until real credentials are available from IT
EMAIL_PROVIDER=captured_test

# Option A — Microsoft 365 Graph API (preferred for PIL Office 365)
# Requires Azure App Registration with Mail.Send permission
MS_GRAPH_TENANT_ID=<REPLACE_THIS: Azure tenant ID from IT>
MS_GRAPH_CLIENT_ID=<REPLACE_THIS: Azure app client ID>
MS_GRAPH_CLIENT_SECRET=<REPLACE_THIS: Azure app client secret>
MS_GRAPH_SENDER_EMAIL=claims-notifications@pilship.com

# Option B — Standard SMTP (Nodemailer)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<REPLACE_THIS: SMTP username/email>
SMTP_PASS=<REPLACE_THIS: SMTP password from IT>
SMTP_FROM="Pacific International Lines" <claims-notifications@pilship.com>

# ── Logging ──────────────────────────────────────────────────
# Set to 'true' to enable verbose PostgreSQL query logging (development only)
DEBUG_SQL=false

# ── Currency API ─────────────────────────────────────────────
# Frankfurter API is free and requires no API key
# Override base URL only if using a private mirror
CURRENCY_API_URL=https://api.frankfurter.app
