# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pil_claims_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false

# Dedicated Least-Privilege Application Runtime User (DML only)
DB_APP_USER=pil_app_user

# Security & Secrets
JWT_SECRET=your_jwt_secret_here
OTP_SALT=your_cryptographic_otp_salt_here

# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# CORS (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# Email Service Provider Configuration
# Options: 'ms_graph' (Production Microsoft 365), 'smtp' (Standard SMTP), 'captured_test' (Safe local outbox)
EMAIL_PROVIDER=captured_test

# Option A: Microsoft 365 (Microsoft Graph API OAuth 2.0 Client Credentials Grant)
# Required permissions in Azure App Registration: Mail.Send (Application)
MS_GRAPH_TENANT_ID=your-azure-tenant-id-here
MS_GRAPH_CLIENT_ID=your-azure-client-id-here
MS_GRAPH_CLIENT_SECRET=your-azure-client-secret-here
MS_GRAPH_SENDER_EMAIL=claims-notifications@pilship.com

# Option B: Standard Corporate SMTP Transport
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=claims-notifications@pilship.com
SMTP_PASS=your-smtp-password-here
SMTP_FROM="Pacific International Lines" <claims-notifications@pilship.com>
