# ── Dependencies ─────────────────────────────────────────
node_modules/
client/node_modules/

# ── Environment & Secrets (NEVER commit real .env) ───────
.env
.env.local
.env.production
!.env.example
!.env.production.example

# ── Build Output ─────────────────────────────────────────
client/dist/
dist/

# ── Logs ─────────────────────────────────────────────────
logs/
*.log

# ── Database Files (SQLite legacy) ───────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm

# ── Backups (contain production data) ────────────────────
backups/
*.pgdump
uploads_BACKUP_*/

# ── Uploads (binary files — stored in PostgreSQL BYTEA) ──
uploads/

# ── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Releases & Deployment ───────────────────────────────
releases/

# ── Test Artifacts ───────────────────────────────────────
coverage/
.nyc_output/

# ── PID files ────────────────────────────────────────────
*.pid
